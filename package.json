{
  "name": "zooclaw-docs",
  "version": "0.0.1",
  "private": true,
  "description": "Public developer documentation for ZooWork Managed Agents",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "vitepress dev docs --port ${DOCS_PORT:-5175}",
    "build": "vitepress build docs && cp _redirects dist/_redirects && node scripts/check-ai-docs.mjs",
    "check:ai-docs": "node scripts/check-ai-docs.mjs",
    "preview": "vitepress preview docs --port ${DOCS_PORT:-5175}",
    "preview:worker": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@heroicons/vue": "^2.2.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "^1.13.4",
    "wrangler": "4.153.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vite": "^6.4.5",
      "nanoid@<3.3.18": "3.3.18",
      "esbuild@<0.25.0": ">=0.25.0",
      "vue@<3.5.42": "3.5.42",
      "markdown-it@<14.3.3": "14.3.3",
      "source-map-js@<1.2.2": "1.2.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12"
    }
  }
}
