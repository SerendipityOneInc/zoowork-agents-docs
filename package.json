{
  "name": "zooclaw-docs",
  "version": "0.0.1",
  "private": true,
  "description": "Public developer documentation for ZooClaw Managed Agents",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "vitepress dev docs --port ${DOCS_PORT:-5175}",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs --port ${DOCS_PORT:-5175}",
    "preview:worker": "wrangler dev",
    "deploy": "vitepress build docs && wrangler deploy"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "^1.13.4",
    "wrangler": "4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
